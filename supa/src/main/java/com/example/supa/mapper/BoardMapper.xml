<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.supa.mapper.BoardMapper">

	<select id="selectBoardList" resultType="com.example.supa.dto.BoardDto">
		SELECT
			id,title,create_at AS createAt
		FROM board
		ORDER BY id DESC;
	</select>
	
	<select id="selectBoardOne" parameterType="int" resultType="com.example.supa.dto.BoardDto">
		SELECT
			id,title,create_at AS createAt
		FROM board
		WHERE id = ${id}
	</select>
	
	<update id="editBoard" parameterType="com.example.supa.dto.BoardDto">
		UPDATE board SET 
		title = #{title} 
		WHERE id = #{id}
	</update>
	
	<delete id="deleteBoard" parameterType="int">
		DELETE FROM board
		WHERE id = #{id}
	</delete>

	<insert id="addBoard" parameterType="com.example.supa.dto.BoardDto">
		INSERT INTO board(title) VALUES(#{title})
	</insert>

</mapper>